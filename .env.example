# Supabase Configuration
# Provide real credentials if connected to a live Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Configuration: 'mock' or 'real'
# In 'mock' mode, Dream Cake AI uses rich browser-persisted mock storage & authentication
# with zero setup required, while supporting real Supabase seamlessly when credentials exist.
VITE_AI_MODE=mock
VITE_PAYMENT_MODE=mock
VITE_STORAGE_MODE=mock
